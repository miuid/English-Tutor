# English Tutor backend configuration
# Copy this file to .env and fill in real values.

APP_ENV=development
DATABASE_URL=sqlite:///./english_tutor.db
LLM_PROVIDER=kimi
LLM_MODEL=kimi-k3
LLM_API_KEY=your-api-key-here

# Soft daily session time budget in minutes (default 15). When it runs out the
# session wraps up and pauses; unfinished stages continue the next day.
SESSION_TIME_LIMIT_MINUTES=15

# Available LLM providers:
#   kimi      -> Moonshot AI Kimi K3 (OpenAI-compatible). Key at https://platform.moonshot.ai/
#   deepseek  -> DeepSeek. Key at https://platform.deepseek.com/
#   anthropic -> Claude. Key at console.anthropic.com
#   fake      -> offline demos/tests; no key required

# Optional per-stage model routing (ISS-021): JSON object mapping loop_stage
# to a model override within the same provider. Stages not listed use
# LLM_MODEL. Loop stages: retrieval, start, I do, we do, you do, triage,
# coach, end, baseline. Example — heavy judgement stages on the strong model,
# light stages on a cheaper tier:
# LLM_STAGE_MODELS={"triage": "kimi-k3", "coach": "kimi-k3", "end": "kimi-k3", "retrieval": "kimi-k3-mini", "start": "kimi-k3-mini", "I do": "kimi-k3-mini", "we do": "kimi-k3-mini", "you do": "kimi-k3-mini"}
