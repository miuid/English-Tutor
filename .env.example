# English Tutor backend configuration
# Copy this file to .env and fill in real values.

APP_ENV=development
DATABASE_URL=sqlite:///./english_tutor.db
LLM_PROVIDER=kimi
LLM_MODEL=kimi-k3
LLM_API_KEY=your-api-key-here

# Soft daily session time budget in minutes (default 15). When it runs out the
# session wraps up and pauses; unfinished stages continue the next day.
SESSION_TIME_LIMIT_MINUTES=15

# Available LLM providers:
#   kimi      -> Moonshot AI Kimi K3 (OpenAI-compatible). Key at https://platform.moonshot.ai/
#   deepseek  -> DeepSeek. Key at https://platform.deepseek.com/
#   anthropic -> Claude. Key at console.anthropic.com
#   fake      -> offline demos/tests; no key required
